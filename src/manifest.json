{
  "manifest_version": 3,
  "name": "Auto Tab Switcher",
  "description": "Automatically switches to the next tab every few seconds",
  "version": "1.2.0",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "windows",
    "downloads"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Pause/Resume auto-switching"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
  }
}
